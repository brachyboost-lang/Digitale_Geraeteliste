<Window x:Class="Digitale_Geraeteliste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Digitale_Geraeteliste"
        mc:Ignorable="d"
        Title="Digitale Geraeteliste" Height="720" Width="1640">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Verleihübersicht" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding textBoxFilter, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,10" />
        <DataGrid Grid.Row="1" Grid.Column="0"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Inventarnr." Binding="{Binding InventoryNumber}" />
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryName}" />
                <DataGridTextColumn Header="Entliehen von" Binding="{Binding LendByEmployeeName}" />
                <DataGridTextColumn Header="Entliehen an" Binding="{Binding BorrowedByEmployeeName}" /> 
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                <DataGridTextColumn Header="Ausgabedatum" Binding="{Binding LendDate, StringFormat=dd.MM.yyyy}" />
                <DataGridTextColumn Header="Rückgabe bis" Binding="{Binding ExpectedReturnDate, StringFormat=dd.MM.yyyy}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Width="200">
            <Button Content="Offene Verleihe anzeigen" Command="{Binding ShowOpenLendsCommand}" Margin="0,0,0,8" Padding="6" />
            <Button Content="Überfällige Verleihe anzeigen" Command="{Binding ShowOverdueLendsCommand}" Margin="0,0,0,8" Padding="6" />
            <Button Content="Überfällige Verleihe Exportieren" Command="{Binding ExportOverdueLendsCommand}" Margin="0,0,0,8" Padding="6" />
            <Button Content="Filter zurücksetzten" Command="{Binding ShowAllItemsCommand}" Margin="0,0,0,35" Padding="1" />
            <Button Content="Neuer Verleih" Command="{Binding LendCommand}" Margin="0,0,0,8" Padding="6" />
            <Button Content="Rückgabe" Command="{Binding ReturnCommand}" Margin="0,0,0,8" Padding="6" />

        </StackPanel>
    </Grid>
</Window>
